# Copy to keystore.properties (git-ignored) and fill in. Alternatively set the DUMPKINPLUS_KEYSTORE_FILE,
# DUMPKINPLUS_KEYSTORE_PASSWORD, DUMPKINPLUS_KEY_ALIAS and DUMPKINPLUS_KEY_PASSWORD environment variables.
storeFile=C:/Users/you/.dumpkinplus/dumpkinplus-release.jks
storePassword=change-me
keyAlias=dumpkinplus
keyPassword=change-me
